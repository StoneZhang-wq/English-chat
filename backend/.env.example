# =============================================================================
# MyEnglishChat backend — 环境变量（复制为 .env 后填写）
# =============================================================================
#
# 【豆包 / 火山方舟 · 文本 LLM】与 English-Chat 的 service/openai.py 相同：
#   - HTTP：POST {OPENAI_BASE_URL}/chat/completions
#   - 头：Authorization: Bearer {OPENAI_API_KEY}
#   - 体：{ "model", "messages", "temperature", "max_tokens" }（非流式）
# 这与方舟控制台「OpenAI 兼容」接口一致；不是 doubao.py 里的 TTS/WebSocket。
#
# 控制台：火山引擎 → 豆包大模型 / 方舟 → 创建推理接入点，拿到 API Key 与接入点。
# 区域若选「华北2（北京）」，Base URL 一般为下方默认值（以控制台文档为准）。
#
# -----------------------------------------------------------------------------

# 方舟 API Key（或控制台显示的「API Key」，用于 Bearer；勿泄露、勿提交 Git）
OPENAI_API_KEY=

# 不含末尾路径：请求时会拼接 /chat/completions
# 北京区域常见：
OPENAI_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# 模型字段：填你在方舟创建的「推理接入点 ID」（多为 ep- 开头），或控制台文档要求的模型标识
# 示例占位，请换成你自己的接入点 / 模型名：
OPENAI_MODEL=ep-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# -----------------------------------------------------------------------------
# 本机 HTTP 服务（Android 模拟器默认连 10.0.2.2:本机端口）
# -----------------------------------------------------------------------------
SERVER_HOST=0.0.0.0
SERVER_PORT=8088
