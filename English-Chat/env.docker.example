# Docker 部署时可将本文件复制为 .env 并修改（或通过 docker-compose environment 传入）
# 应用通过 config 读取环境变量，优先使用此处配置

# 服务
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# MySQL（与 docker-compose 中 mysql 服务一致）
DB_HOST=mysql
DB_PORT=3306
DB_NAME=chat
DB_USER=chat_user
DB_PASSWORD=chat134!
DB_ROOT_PASSWORD=rootpass

# Redis（与 docker-compose 中 redis 服务一致）
REDIS_HOST=redis
REDIS_PORT=6379

# 日志与数据（容器内路径，对应卷挂载）
DATA_PATH=/app/data
LOG_PATH=/app/logs/chat.log
LOG_LEVEL=info

# 可选：LLM / 豆包 等
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# CHARACTER_PATH=/app/characters
# CHARACTER_NAME=english_tutor
