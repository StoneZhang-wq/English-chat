# Copy this file to .env and fill in your values
#
# NOTE: The application automatically loads .env file on startup if it exists.
# You can also use .env.local for local overrides (not tracked in git).

# OpenAI (default)
# ============================
OPENAI_API_KEY=OPENAI-key
OPENAI_BASE_URL=http://localhost/ai/v1
OPENAI_VL_MODEL=gpt-4o-mini
OPENAI_MODE=minimax-m2.5



# OR Google Gemini (for Infographics and Nano Banana)
# ============================
GOOGLE_API_KEY=your-google-api-key-here

# Server Configuration
# ============================
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# ============== MySQL 配置 ==============
DB_ROOT_PASSWORD=ChatRoot324!
DB_NAME=chat
DB_USER=chat_user
DB_PASSWORD=123456
DB_PORT=3306
DB_HOST=mysql

# Cache Configuration
REDIS_PORT=6379

# log Configuration
LOG_PATH=/app/logs/notex.log
LOG_LEVEL=info

# data Configuration
DATA_PATH=/app/data

# 豆包 ASR（录音文件识别，可选）
# VOLCENGINE_ASR_APP_ID=
# VOLCENGINE_ASR_ACCESS_TOKEN=
# VOLCENGINE_FILE_ASR_RESOURCE_ID=volc.bigasr.auc
# VOLCENGINE_FILE_ASR_BASE_URL=https://openspeech.bytedance.com

# ========== 本地 ASR（faster-whisper）==========
# ASR_PROVIDER=doubao | local
# ASR_PROVIDER=local
# LOCAL_WHISPER_MODEL_SIZE=base
# LOCAL_WHISPER_MODEL_SIZE=small
# LOCAL_WHISPER_DEVICE=cpu
# LOCAL_WHISPER_DEVICE=cuda
# LOCAL_WHISPER_COMPUTE_TYPE=int8
# LOCAL_WHISPER_COMPUTE_TYPE=float16
# LOCAL_WHISPER_LANGUAGE=
# LOCAL_WHISPER_LANGUAGE=en
# ASR_CONCURRENCY_LIMIT=2

# ========== TTS：豆包 | Piper ==========
# TTS_PROVIDER=doubao
# TTS_PROVIDER=piper
# VOLCENGINE_APP_ID=
# VOLCENGINE_ACCESS_TOKEN=
# PIPER_EXECUTABLE=piper
# Windows 示例：PIPER_EXECUTABLE=C:\tools\piper\piper.exe
# PIPER_VOICE_EN=C:\models\en_US-lessac-medium.onnx
# PIPER_VOICE_EN_B=
# PIPER_VOICE_ZH=
# Piper 模型与 .onnx.json 见：https://github.com/rhasspy/piper/blob/master/VOICES.md