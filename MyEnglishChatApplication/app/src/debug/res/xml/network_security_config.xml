<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
      Debug 构建：允许明文 HTTP，便于真机访问局域网里的本机后端（如 http://192.168.x.x:8088）。
      Release 仍使用 main 中的 network_security_config（仅放行常见本机域名）。
    -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
